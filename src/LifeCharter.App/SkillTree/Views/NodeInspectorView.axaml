<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LifeCharter.App.SkillTree.ViewModels"
             xmlns:siege="using:LifeCharter.App.Siege.ViewModels"
             xmlns:retention="using:LifeCharter.Core.Retention.Models"
             x:Class="LifeCharter.App.SkillTree.Views.NodeInspectorView"
             x:DataType="vm:NodeInspectorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="16">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding !CanEditNode}" />
      <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#9AA0AE" />
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#C8CCD6" IsVisible="{Binding !CanEditNode}" />

      <StackPanel Spacing="8" IsVisible="{Binding CanEditNode}">
        <TextBox Text="{Binding Title}" PlaceholderText="Title" />
        <TextBox Text="{Binding Description}" PlaceholderText="Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
        <TextBox Text="{Binding Aliases}" PlaceholderText="Quick-entry words, comma-separated (run, jog)"
                 ToolTip.Tip="Words that quick entry maps to this node, for example: run, jog, bike" />
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Text="Attribute" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                    ItemsSource="{x:Static vm:NodeInspectorViewModel.Attributes}" SelectedItem="{Binding Attribute}" />
          <TextBlock Grid.Row="1" Text="Kind" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                    ItemsSource="{x:Static vm:NodeInspectorViewModel.Kinds}" SelectedItem="{Binding Kind}" />
          <TextBlock Grid.Row="2" Text="Retention" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                    ItemsSource="{x:Static vm:NodeInspectorViewModel.RetentionModels}" SelectedItem="{Binding RetentionModel}" />
          <TextBlock Grid.Row="3" Text="Complexity" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"
                    ItemsSource="{x:Static vm:NodeInspectorViewModel.Complexities}" SelectedItem="{Binding Complexity}"
                    ToolTip.Tip="Habits: simple ones engrave after half the repetitions, complex ones after twice as many" />
        </Grid>
        <Button Content="Save node" Command="{Binding SaveNodeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding ShowAllocate}">
        <Button Classes="accent" Content="Allocate · 1 skill point" Command="{Binding AllocateCommand}" IsEnabled="{Binding CanAllocate}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <TextBlock Text="{Binding AllocationHint}" FontSize="12" Foreground="#E5A84D" TextWrapping="Wrap" />
      </StackPanel>
      <Button Content="Refund point" Command="{Binding RefundCommand}" IsVisible="{Binding CanRefund}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

      <Border Background="#1A1D24" CornerRadius="8" Padding="10" IsVisible="{Binding HasRetention}">
        <StackPanel Spacing="6" DataContext="{Binding Retention}" x:DataType="siege:RetentionViewModel">
          <TextBlock Text="Retention" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ModelText}" FontSize="12" Foreground="#9AA0AE" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AttackText}" FontSize="12" Foreground="#FF7A7E" TextWrapping="Wrap" IsVisible="{Binding IsAttacked}" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Integrity}" Height="6" MinWidth="0" Foreground="#F5A524" />
          <TextBlock Text="{Binding IntegrityText}" FontSize="12" Foreground="#C8CCD6" TextWrapping="Wrap" />

          <StackPanel Spacing="4" IsVisible="{Binding ShowProgress}" Margin="0,4,0,0">
            <TextBlock Text="{Binding ProgressTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E8C36A" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="6" MinWidth="0" Foreground="#E8C36A" />
            <ItemsControl ItemsSource="{Binding Criteria}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" Foreground="#9AA0AE" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding EstimateText}" FontSize="12" Foreground="#9AA0AE" FontStyle="Italic" TextWrapping="Wrap"
                       IsVisible="{Binding HasEstimate}" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding CanRecall}" Margin="0,4,0,0">
            <TextBlock Text="Recall first (blank page, explain it aloud), then rate how it went:" FontSize="12" Foreground="#C8CCD6" TextWrapping="Wrap" />
            <UniformGrid Columns="4">
              <Button Content="Again" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Again}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
              <Button Content="Hard" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Hard}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
              <Button Content="Good" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Good}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
              <Button Content="Easy" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Easy}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
          </StackPanel>

          <Border IsVisible="{Binding NeedsSelfCheck}" Margin="0,4,0,0">
            <StackPanel Spacing="4" DataContext="{Binding SelfCheck}" x:DataType="siege:SelfCheckViewModel">
              <TextBlock Text="Automaticity self-check" FontSize="12" FontWeight="SemiBold" Foreground="#E8C36A" />
              <TextBlock Text="{Binding Intro}" FontSize="12" Foreground="#C8CCD6" TextWrapping="Wrap" />
              <TextBlock Text="I do it automatically." FontSize="12" Foreground="#9AA0AE" />
              <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Automatically}" />
              <TextBlock Text="I do it without having to consciously remember." FontSize="12" Foreground="#9AA0AE" />
              <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WithoutRemembering}" />
              <TextBlock Text="I do it without thinking." FontSize="12" Foreground="#9AA0AE" />
              <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WithoutThinking}" />
              <TextBlock Text="I start doing it before I realize I'm doing it." FontSize="12" Foreground="#9AA0AE" />
              <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BeforeRealizing}" />
              <Button Content="Submit self-check" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Text="Goals" FontWeight="SemiBold" IsVisible="{Binding HasGoals}" />
      <ItemsControl ItemsSource="{Binding Goals}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GoalItemViewModel">
            <Border Background="#1A1D24" CornerRadius="8" Padding="10" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding !IsEditing}" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="6" MinWidth="0" Foreground="#E8C36A" />
                <TextBlock Text="{Binding ProgressDescription}" FontSize="12" Foreground="#9AA0AE" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !IsEditing}">
                  <NumericUpDown Value="{Binding LogAmount}" Minimum="0" Increment="1" FormatString="0.##" />
                  <TextBlock Grid.Column="1" Text="{Binding UnitLabel}" VerticalAlignment="Center" Margin="8,0" Foreground="#9AA0AE" />
                  <Button Grid.Column="2" Content="Log" Command="{Binding LogCommand}" />
                </Grid>
                <TextBox Text="{Binding LogNote}" PlaceholderText="Note (optional)" IsVisible="{Binding !IsEditing}" />

                <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                  <TextBox Text="{Binding Title}" PlaceholderText="Goal title" />
                  <Grid ColumnDefinitions="*,*">
                    <ComboBox ItemsSource="{x:Static vm:GoalItemViewModel.Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:GoalItemViewModel.Windows}" SelectedItem="{Binding Window}" HorizontalAlignment="Stretch" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*">
                    <NumericUpDown Value="{Binding Target}" Minimum="0" FormatString="0.##" Margin="0,0,4,0" ToolTip.Tip="Target per period" />
                    <TextBox Grid.Column="1" Text="{Binding Unit}" PlaceholderText="Unit (km, min, l…)" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown Value="{Binding Periods}" Minimum="1" FormatString="0" ToolTip.Tip="Days or weeks that must meet the target" />
                    <CheckBox Grid.Column="1" Content="In a row" IsChecked="{Binding Consecutive}" Margin="8,0,0,0" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save goal" Command="{Binding SaveCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Foreground="#E5484D" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Spacing="4" IsVisible="{Binding HasRecentEntries}">
        <TextBlock Text="Recent entries" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding RecentEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentEntryViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#C8CCD6" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" FontSize="12" Padding="8,2" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding CanEditNode}">
        <Button Content="Add goal" Command="{Binding AddGoalCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Content="Delete node" Command="{Binding DeleteNodeCommand}" Foreground="#E5484D"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
