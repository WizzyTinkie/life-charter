<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LifeCharter.App.Widget.Views"
        xmlns:vm="using:LifeCharter.App.Widget.ViewModels"
        x:Class="LifeCharter.App.Widget.Views.PeekWindow"
        x:DataType="vm:WidgetViewModel"
        Title="LifeCharter Peek"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <views:WidgetContent x:Name="Body" />
</Window>
