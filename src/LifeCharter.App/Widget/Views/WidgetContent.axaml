<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LifeCharter.App.Widget.ViewModels"
             xmlns:retention="using:LifeCharter.Core.Retention.Models"
             x:Class="LifeCharter.App.Widget.Views.WidgetContent"
             x:DataType="vm:WidgetViewModel"
             Width="300">
  <Border CornerRadius="16"
          Background="#E6181A20"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          Padding="14">
    <StackPanel Spacing="10">
      <Grid x:Name="Header" ColumnDefinitions="*,Auto,Auto" Background="Transparent" Cursor="SizeAll">
        <TextBlock Text="LifeCharter" FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F2" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontWeight="Bold" Foreground="#E8C36A" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Tree" Command="{Binding OpenTreeCommand}" Padding="8,2" FontSize="12" />
      </Grid>

      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="Health" FontSize="12" Foreground="#B0B0B0" />
          <ProgressBar Grid.Column="1" Value="{Binding HealthShare}" Height="6" MinWidth="0" Foreground="#4CAF50" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="Stamina" FontSize="12" Foreground="#B0B0B0" />
          <ProgressBar Grid.Column="1" Value="{Binding StaminaShare}" Height="6" MinWidth="0" Foreground="#E5484D" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="Might" FontSize="12" Foreground="#B0B0B0" />
          <ProgressBar Grid.Column="1" Value="{Binding MightShare}" Height="6" MinWidth="0" Foreground="#3E8EF7" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding ShowSiege}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding SiegeHeader}" FontSize="12" Foreground="#FF9A9D" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{Binding WardText}" Command="{Binding UseWardCommand}" IsVisible="{Binding CanUseWard}"
                  FontSize="11" Padding="6,1" ToolTip.Tip="Spend a ward to shield today from all damage" />
        </Grid>
        <TextBlock Text="{Binding SiegeNote}" FontSize="11" Foreground="#9AA0AE" IsVisible="{Binding HasSiegeNote}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Defense}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DefenseItemViewModel">
              <StackPanel Margin="0,1">
                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsDefended}" IsEnabled="{Binding !IsDefended}"
                          Command="{Binding DefendCommand}" IsVisible="{Binding IsTick}" />
                <StackPanel Spacing="2" IsVisible="{Binding IsRecall}">
                  <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                  <UniformGrid Columns="4" IsVisible="{Binding CanRecall}">
                    <Button Content="Again" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Again}"
                            FontSize="11" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0" />
                    <Button Content="Hard" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Hard}"
                            FontSize="11" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0" />
                    <Button Content="Good" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Good}"
                            FontSize="11" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0" />
                    <Button Content="Easy" Command="{Binding RecallCommand}" CommandParameter="{x:Static retention:ReviewRating.Easy}"
                            FontSize="11" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </UniformGrid>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Text="{Binding TodayHeader}" FontSize="12" Foreground="#B0B0B0" />
      <ItemsControl ItemsSource="{Binding Today}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TodayItemViewModel">
            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsDone}" IsEnabled="{Binding !IsDone}"
                      Command="{Binding CompleteCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasLastEntry}">
        <TextBlock Text="{Binding LastEntryText}" FontSize="11" Foreground="#9AA0AE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Content="Undo" Command="{Binding UndoLastCommand}" FontSize="11" Padding="6,1" Margin="6,0,0,0" />
      </Grid>

      <TextBox x:Name="QuickEntry" PlaceholderText="Quick entry arrives in Phase 3" IsEnabled="False" />
    </StackPanel>
  </Border>
</UserControl>
